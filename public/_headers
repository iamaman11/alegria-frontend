# Cloudflare Pages caching configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# IMPORTANT: Do NOT set Cache-Control for HTML pages (/)
# Let Next.js/OpenNext manage ISR headers automatically
# This includes dynamic pages with revalidate settings

# Static assets - cache for 1 year (immutable)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and media - cache for 1 week
/media/*
  Cache-Control: public, max-age=604800

# Monitoring APIs - allow CDN caching for 1 hour
/api/health
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/api/stats
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/api/d1/stats
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/api/r2/stats
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

# Management APIs - never cache (cache invalidation endpoints)
/api/cache-purge/*
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0

/api/cache-tags/*
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0

# Other API routes - conservative, no cache
/api/*
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0

# Favicon - cache for 1 day
/favicon.ico
  Cache-Control: public, max-age=86400

# robots.txt and sitemap - cache for 1 hour
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
