{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "build:worker": "cross-env NODE_OPTIONS=--no-deprecation next build && npx @opennextjs/cloudflare build",
    "preview": "npm run build:worker && npx wrangler pages dev .open-next",
    "deploy": "npm run build:worker && npx wrangler pages deploy .open-next --project-name=alegria-frontend --commit-dirty=true",
    "deploy:pages": "npm run build:worker && npx wrangler pages deploy .open-next --project-name=alegria-frontend --commit-dirty=true",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "geist": "^1.5.1",
    "lucide-react": "^0.548.0",
    "next": "16.0.1",
    "next-sitemap": "^4.2.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "sass": "^1.93.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/admin-bar": "^3.61.1",
    "@payloadcms/live-preview-react": "^3.61.1",
    "@payloadcms/richtext-lexical": "^3.61.1",
    "@payloadcms/ui": "^3.61.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "cpx": "^1.5.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.2"
  }
}
