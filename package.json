{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "build:worker": "cross-env NODE_OPTIONS=--no-deprecation next build && npx @opennextjs/cloudflare build && npx cpx \"functions/**\" .open-next/functions/",
    "preview": "npm run build:worker && npx wrangler pages dev .open-next",
    "deploy": "npm run build:worker && npx wrangler pages deploy .open-next --project-name=alegria-frontend --commit-dirty=true",
    "deploy:pages": "npm run build:worker && npx wrangler pages deploy .open-next --project-name=alegria-frontend --commit-dirty=true",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.60.0",
    "@payloadcms/live-preview-react": "^3.60.0",
    "@payloadcms/richtext-lexical": "^3.60.0",
    "@payloadcms/ui": "^3.60.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.546.0",
    "next": "15.2.3",
    "next-sitemap": "^4.2.3",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "sass": "^1.93.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "latest",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.20",
    "cpx": "^1.5.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.44.0"
  }
}
